{
  "name": "ptq-viewer-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen:geo": "node scripts/build-geo.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "prebuild": "node scripts/build-geo.mjs && node scripts/sync-data.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "bench": "node scripts/bench.mjs",
    "anchors": "node scripts/check-anchors.mjs",
    "measure": "node scripts/measure-bundle.mjs",
    "predev": "node scripts/build-geo.mjs && node scripts/sync-data.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-sankey": "^0.12.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-sankey": "^0.11.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/topojson-client": "^3.1.5",
    "topojson-server": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
